{
    "name": "level51/silverstripe-jwt-utils",
    "license": "MIT",
    "type": "silverstripe-vendormodule",
    "description": "Utilities for dealing with JWT in SilverStripe",
    "authors": [
        {
            "name": "Julian Scheuchenzuber",
            "email": "js@lvl51.de"
        }
    ],
    "require": {
        "php": "^8.1",
        "firebase/php-jwt": "^6.0 || ^7.0",
        "nesbot/carbon": "^2.70 || ^3",
        "ramsey/uuid": "^4.7.4",
        "silverstripe/framework": "^4 || ^5 || ^6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^11",
        "silverstripe/sqlite3": "^3 || ^4"
    },
    "autoload": {
        "psr-4": {
            "Level51\\JWTUtils\\": "code/",
            "Level51\\JWTUtils\\Tests\\": "tests/"
        }
    }
}
